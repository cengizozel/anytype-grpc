# Copy this file to .env and fill in your own values. The .env file is gitignored.
#
# ANYTYPE_TOKEN is a full-scope session token for your local Anytype account.
# Mint it from your recovery phrase with:  python -m anytype_grpc.auth
# Treat it like a password. It grants full control of your local vault.
ANYTYPE_TOKEN=

# Optional. The gRPC address of the running Anytype desktop app.
# Leave blank to auto-discover the port from the running anytypeHelper process.
ANYTYPE_GRPC_ADDR=

# Optional. The space you want to operate on by default.
ANYTYPE_SPACE_ID=
